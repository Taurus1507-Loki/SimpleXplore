# ==============================================================================
# SimpleXplore Environment Configuration
# ==============================================================================

# Public Supabase API Settings
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (Used strictly server-side for admin verification, webhooks, and migrations)
# NEVER expose this key to client-side code!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Public Site URL (Used for canonical links, sitemaps, and affiliate redirect callbacks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Telegram Bot Integration
# 1. Create a bot via @BotFather on Telegram to obtain TELEGRAM_BOT_TOKEN
# 2. Add the bot as an Administrator to your affiliate channel with Post/Edit rights
# 3. Set a high-entropy secret token for TELEGRAM_WEBHOOK_SECRET to verify incoming Telegram payloads
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_WEBHOOK_SECRET=super_secret_webhook_random_token_12345

# Single administrator
# ADMIN_EMAIL: the one admin account. In live mode the admin must ALSO have
#   role = 'admin' in public.profiles (granted manually via SQL, see README).
# ADMIN_PASSWORD: used ONLY in demo mode (no Supabase). Ignored when Supabase is configured.
# ADMIN_SESSION_SECRET: random string (min 32 chars) used to sign the admin session cookie.
#   Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=change-me-to-a-long-random-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional Mock / Demo Mode
# If true, runs seamlessly with local mock storage and memory fixtures when Supabase is not yet connected
NEXT_PUBLIC_DEMO_MODE=true

